# Server only. Never put this key in VITE_* variables or frontend settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Optional research access token. If set, clients must send Bearer <token>.
RESEARCH_ACCESS_TOKEN=
# Comma-separated, exact origins; add a LAN HTTPS origin for phone testing.
# Example: append ,https://192.168.1.50:5174 using your Mac's actual LAN IP.
# An origin includes scheme, hostname/IP, and port, without a trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://localhost:5173,https://127.0.0.1:5173,https://localhost:5174,https://127.0.0.1:5174,https://localhost:4173,https://127.0.0.1:4173
